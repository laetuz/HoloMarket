<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.neotica.holomarket">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".NeostoreApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity android:name=".feature.home.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".feature.auth.login.ui.LoginActivity" />
        <activity android:name=".feature.auth.forgotpassword.ui.ForgotPasswordActivity" />
        <activity android:name=".feature.auth.register.ui.RegisterActivity" />
        <activity android:name=".feature.settings.ui.SettingsActivity" />
        <activity android:name=".feature.category.ui.CategoriesActivity" />
        <activity android:name=".feature.detail.ui.AppDetailActivity" />
        <activity android:name=".feature.downloads.ui.DownloadsActivity" />
        <service
            android:name=".feature.downloads.service.DownloadService"
            android:exported="false" />
        <activity
            android:name="id.neotica.holomarket.feature.applist.ui.AppListActivity"
            android:windowSoftInputMode="stateHidden" />
    </application>

</manifest>