<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.neotica.holomarket">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".NeostoreApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity android:name=".ui.feature.home.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.feature.auth.LoginActivity" />
        <activity android:name=".ui.feature.auth.ForgotPasswordActivity" />
        <activity android:name=".ui.feature.auth.RegisterActivity" />
        <activity android:name=".ui.feature.settings.SettingsActivity" />
        <activity android:name=".ui.feature.category.CategoriesActivity" />
        <activity android:name=".ui.feature.detail.AppDetailActivity" />
        <activity
            android:name="id.neotica.holomarket.ui.feature.applist.AppListActivity"
            android:windowSoftInputMode="stateHidden" />
    </application>

</manifest>